# All of these are optional. Every source that needs a key degrades gracefully
# to a "skipped" result when its key is missing — the tool works with zero
# configuration, these just unlock extra sources.

# https://emailrep.io/ — works unauthenticated at a low rate limit; a free key raises it.
EMAILREP_API_KEY=

# https://hunter.io/ — free tier includes 25 email verifications/month.
HUNTER_API_KEY=

# https://haveibeenpwned.com/API/Key — breach search has required a paid key since 2024.
HIBP_API_KEY=
